{
  "name": "@light-cloud/mcp-server",
  "version": "1.5.1",
  "description": "MCP server for Light Cloud Platform - Deploy and manage applications with Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "light-cloud-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "manifest.json",
    "icon.png"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "bundle": "node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "light-cloud",
    "deployment",
    "cloud",
    "ai"
  ],
  "author": "Light Cloud Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/light-cloud-com/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/light-cloud-com/mcp-server/issues"
  },
  "homepage": "https://github.com/light-cloud-com/mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "archiver": "^7.0.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
